{
  "name": "dsh-effort-slider",
  "version": "0.1.3",
  "description": "DSH Web 思考强度就地替换插件：把模型座位「推理等级」面板里的原生单选行替换成 Claude Effort 卡片风格的美丽滑块（Off / Low / High / Max，含 WebGL 火焰），选择仍走官方会话链路。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "effort",
    "reasoning-effort",
    "thinking",
    "ui"
  ],
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build:client": "node build-client.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2"
    }
  },
  "files": [
    "lib",
    "web",
    "src/client",
    "build-client.mjs",
    "package.json",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "vite": "^8.0.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SmailPang/dsh-effort-slider.git"
  },
  "homepage": "https://github.com/SmailPang/dsh-effort-slider#readme",
  "bugs": {
    "url": "https://github.com/SmailPang/dsh-effort-slider/issues"
  }
}
